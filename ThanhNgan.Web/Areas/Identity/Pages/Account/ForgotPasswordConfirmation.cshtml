@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Yêu cầu đặt lại mật khẩu đã được gửi";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <h1>@ViewData["Title"]</h1>
        <p class="mb-0">
            Vui lòng kiểm tra email để đặt lại mật khẩu. (Môi trường demo: nội dung email được ghi vào log server thay vì gửi thật.)
        </p>
    </div>
</div>
