@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <h1>@ViewData["Title"]</h1>
        <p class="mb-0">Mật khẩu của bạn đã được đặt lại. Vui lòng <a asp-page="./Login">bấm vào đây để đăng nhập</a>.</p>
    </div>
</div>
