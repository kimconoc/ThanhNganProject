@model List<Review>
@{ ViewData["Title"] = "Đánh giá sản phẩm"; }
<h2>Đánh giá sản phẩm</h2>
<table class="table table-sm align-middle">
    <thead><tr><th>Ngày</th><th>Sản phẩm</th><th>Khách</th><th>Sao</th><th>Nhận xét</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr class="@(r.IsApproved ? "" : "text-muted")">
            <td>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
            <td>@r.Product.Name</td>
            <td>@(r.User?.FullName ?? r.User?.Email)</td>
            <td class="text-nowrap"><partial name="_Stars" model="(double)r.Rating" /></td>
            <td>@r.Comment</td>
            <td>@(r.IsApproved ? "Đang hiện" : "Đã ẩn")</td>
            <td class="text-nowrap">
                <form asp-action="ToggleApproval" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.Id" />
                    <button class="btn btn-sm btn-outline-secondary">@(r.IsApproved ? "Ẩn" : "Hiện")</button>
                </form>
                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xóa đánh giá này?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.Id" />
                    <button class="btn btn-sm btn-outline-danger">Xóa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (Model.Count == 0) { <p class="text-muted">Chưa có đánh giá nào.</p> }
