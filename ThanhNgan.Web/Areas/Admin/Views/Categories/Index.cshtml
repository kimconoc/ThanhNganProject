@model List<Category>
@{ ViewData["Title"] = "Danh mục"; }
<div class="d-flex justify-content-between mb-3">
    <h2>Danh mục sản phẩm</h2>
    <a asp-action="Create" class="btn btn-primary">+ Thêm danh mục</a>
</div>
<table class="table bg-white">
    <thead><tr><th>Tên</th><th>Danh mục cha</th><th>Thứ tự</th><th></th></tr></thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.ParentCategory?.Name</td>
                <td>@c.DisplayOrder</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa danh mục này?');">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
