@model Category
@{ ViewData["Title"] = "Thêm danh mục"; }
<h2>Thêm danh mục</h2>
<form asp-action="Create" method="post" class="col-md-6">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label class="form-label">Tên danh mục</label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Slug (URL)</label><input asp-for="Slug" class="form-control" /></div>
    <div class="mb-3">
        <label class="form-label">Danh mục cha</label>
        <select asp-for="ParentCategoryId" class="form-select">
            <option value="">-- Danh mục gốc --</option>
            @foreach (var p in (List<Category>)ViewBag.ParentCategories)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>
    </div>
    <div class="mb-3"><label class="form-label">Mô tả</label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="mb-3"><label class="form-label">Thứ tự hiển thị</label><input asp-for="DisplayOrder" class="form-control" /></div>
    <button class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
