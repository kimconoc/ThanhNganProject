@model StaticPage
@{ ViewData["Title"] = "Sửa trang: " + Model.Slug; }
<h2>Sửa nội dung trang: @Model.Slug</h2>
<form asp-action="EditPage" method="post" class="col-md-8">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Slug" />
    <div class="mb-3"><label class="form-label">Tiêu đề</label><input asp-for="Title" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Nội dung (HTML)</label><textarea asp-for="Content" class="form-control" rows="12"></textarea></div>
    <button class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
