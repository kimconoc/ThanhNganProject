@model Order
@{ ViewData["Title"] = "Đơn hàng " + Model.Code; }
<h2>Đơn hàng @Model.Code <span class="badge bg-info">@Model.Status.ToDisplay()</span></h2>
<p>Khách hàng: @Model.RecipientName - @Model.RecipientPhone</p>
<p>Địa chỉ giao: @Model.ShippingAddress (@Model.ShippingMethod?.Name)</p>
<p>Thanh toán: @Model.PaymentMethod.ToDisplay() - @Model.PaymentStatus.ToDisplay()</p>
@if (!string.IsNullOrEmpty(Model.Note)) { <p>Ghi chú KH: @Model.Note</p> }

<table class="table bg-white">
    <thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead>
    <tbody>
        @foreach (var d in Model.Details)
        {
            <tr><td>@d.ProductName (@d.PackagingSpec)</td><td>@d.UnitPrice.ToString("N0")đ</td><td>@d.Quantity</td><td>@d.LineTotal.ToString("N0")đ</td></tr>
        }
    </tbody>
    <tfoot>
        <tr><th colspan="3" class="text-end">Tạm tính</th><th>@Model.SubTotal.ToString("N0")đ</th></tr>
        <tr><th colspan="3" class="text-end">Giảm giá</th><th>-@Model.DiscountAmount.ToString("N0")đ</th></tr>
        <tr><th colspan="3" class="text-end">Phí ship</th><th>@Model.ShippingFee.ToString("N0")đ</th></tr>
        <tr><th colspan="3" class="text-end">Tổng cộng</th><th>@Model.TotalAmount.ToString("N0")đ</th></tr>
    </tfoot>
</table>

<div class="d-flex gap-2 flex-wrap">
    @if (Model.Status == OrderStatus.PendingConfirmation)
    {
        <form asp-action="Confirm" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Xác nhận đơn hàng và tự động xuất kho?');">
            @Html.AntiForgeryToken()
            <button class="btn btn-success">✓ Xác nhận đơn &amp; xuất kho</button>
        </form>
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Hủy đơn hàng này?');">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger">Hủy đơn</button>
        </form>
    }
    @if (Model.Status == OrderStatus.Processing)
    {
        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="status" value="@((int)OrderStatus.Shipping)" />
            <button class="btn btn-primary">Chuyển sang Đang giao</button>
        </form>
    }
    @if (Model.Status == OrderStatus.Shipping)
    {
        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="status" value="@((int)OrderStatus.Completed)" />
            <button class="btn btn-success">Hoàn thành đơn</button>
        </form>
    }
    @if (Model.Status is OrderStatus.Shipping or OrderStatus.Completed)
    {
        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Xử lý hoàn trả đơn hàng này?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="status" value="@((int)OrderStatus.Returned)" />
            <button class="btn btn-outline-warning">Hoàn trả</button>
        </form>
    }
    <a asp-action="Invoice" asp-route-id="@Model.Id" class="btn btn-outline-secondary" target="_blank">🖨 In hóa đơn</a>
</div>
