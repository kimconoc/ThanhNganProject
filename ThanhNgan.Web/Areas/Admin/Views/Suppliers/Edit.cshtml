@model Supplier
@{ ViewData["Title"] = "Sửa nhà cung cấp"; }
<h2>Sửa nhà cung cấp</h2>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-md-6">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label class="form-label">Tên</label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Người liên hệ</label><input asp-for="ContactName" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Số điện thoại</label><input asp-for="Phone" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Địa chỉ</label><input asp-for="Address" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Ghi chú</label><textarea asp-for="Note" class="form-control"></textarea></div>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label class="form-check-label">Đang hợp tác</label>
    </div>
    <button class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
