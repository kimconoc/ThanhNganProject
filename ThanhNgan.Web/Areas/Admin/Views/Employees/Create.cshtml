@model ThanhNgan.Web.Areas.Admin.Models.CreateEmployeeForm
@{ ViewData["Title"] = "Thêm nhân viên"; }
<h2>Thêm tài khoản nhân viên</h2>
<form asp-action="Create" method="post" class="col-md-6">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label class="form-label">Họ tên</label><input asp-for="FullName" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Email (dùng để đăng nhập)</label><input asp-for="Email" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Mật khẩu</label><input asp-for="Password" type="password" class="form-control" /></div>
    <div class="mb-3">
        <label class="form-label">Vai trò</label>
        <select asp-for="Role" class="form-select">
            <option value="WarehouseStaff">Nhân viên kho</option>
            <option value="SalesStaff">Nhân viên bán hàng</option>
            <option value="Manager">Quản lý</option>
            <option value="Admin">Admin</option>
        </select>
    </div>
    <button class="btn btn-primary">Tạo tài khoản</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
