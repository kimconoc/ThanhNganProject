@model BlogPost
@{ ViewData["Title"] = Model.Title; }
<div class="container my-4">
    <h2>@Model.Title</h2>
    <p class="text-muted">@Model.PublishedAt.ToString("dd/MM/yyyy")</p>
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="img-fluid mb-3" />
    }
    <div>@Html.Raw(Model.Content)</div>
</div>
