@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hero-banner text-center mb-4">
    <div class="container">
        <h1 class="display-5">Thanh Ngân Seafood</h1>
        <p class="lead">Hải sản đông lạnh - tươi sống - mắm cá cơm, tươi ngon mỗi ngày, giao tận nơi</p>
        <a class="btn btn-light btn-lg" asp-controller="Shop" asp-action="Index">Mua ngay</a>
    </div>
</div>

<div class="container">
    <div class="row text-center mb-5">
        @foreach (var cat in Model.TopCategories)
        {
            <div class="col-md-4 mb-3">
                <a asp-controller="Shop" asp-action="Index" asp-route-categorySlug="@cat.Slug" class="text-decoration-none text-dark">
                    <div class="card category-tile p-3 shadow-sm h-100">
                        <h5>@cat.Name</h5>
                        <p class="text-muted small mb-0">@cat.Description</p>
                    </div>
                </a>
            </div>
        }
    </div>

    @if (Model.BestSellers.Count > 0)
    {
        <h3 class="section-title mb-3">Bán chạy nhất</h3>
        <div class="row">
            @foreach (var p in Model.BestSellers) { <partial name="_ProductCard" model="p" /> }
        </div>
    }

    @if (Model.FeaturedProducts.Count > 0)
    {
        <h3 class="section-title mb-3 mt-4">Sản phẩm nổi bật</h3>
        <div class="row">
            @foreach (var p in Model.FeaturedProducts) { <partial name="_ProductCard" model="p" /> }
        </div>
    }

    @if (Model.CheapProducts.Count > 0)
    {
        <h3 class="section-title mb-3 mt-4">Sản phẩm giá rẻ</h3>
        <div class="row">
            @foreach (var p in Model.CheapProducts) { <partial name="_ProductCard" model="p" /> }
        </div>
    }

    @if (Model.NewestProducts.Count > 0)
    {
        <h3 class="section-title mb-3 mt-4">Tất cả sản phẩm</h3>
        <div class="row">
            @foreach (var p in Model.NewestProducts) { <partial name="_ProductCard" model="p" /> }
        </div>
    }

    @if (Model.LatestPosts.Count > 0)
    {
        <h3 class="section-title mb-3 mt-4">Cẩm nang chế biến hải sản</h3>
        <div class="row mb-4">
            @foreach (var post in Model.LatestPosts)
            {
                <div class="col-md-4 mb-3">
                    <a asp-controller="Home" asp-action="BlogDetail" asp-route-slug="@post.Slug" class="text-decoration-none text-dark">
                        <div class="card h-100">
                            <div class="card-body">
                                <h6>@post.Title</h6>
                                <p class="small text-muted">@post.Summary</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
