@{
    ViewData["Title"] = "Liên hệ";
    var success = TempData["ContactSuccess"] as string;
    var contact = ((string Hotline, string Zalo, string Messenger, string Email))ViewBag.Contact;
}

<div class="container my-4">
    <h2>Liên hệ với chúng tôi</h2>
    @if (!string.IsNullOrEmpty(success))
    {
        <div class="alert alert-success">@success</div>
    }
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Contact" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3"><label class="form-label">Họ tên</label><input name="Name" class="form-control" required /></div>
                <div class="mb-3"><label class="form-label">Số điện thoại</label><input name="Phone" class="form-control" required /></div>
                <div class="mb-3"><label class="form-label">Email</label><input name="Email" class="form-control" /></div>
                <div class="mb-3"><label class="form-label">Nội dung</label><textarea name="Content" class="form-control" required></textarea></div>
                <button type="submit" class="btn btn-primary">Gửi liên hệ</button>
            </form>
        </div>
        <div class="col-md-6">
            <h5>Thông tin cửa hàng</h5>
            <p>Hotline: @contact.Hotline<br />Zalo: @contact.Zalo<br />Email: @contact.Email</p>
            <p>Địa chỉ: 123 Đường Hải Sản, TP. Cà Mau</p>
        </div>
    </div>
</div>
