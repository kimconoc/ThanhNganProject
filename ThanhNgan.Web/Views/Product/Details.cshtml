@model ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.Name;
    var p = Model.Product;
    var images = p.Images.OrderByDescending(i => i.IsMain).ThenBy(i => i.DisplayOrder).ThenBy(i => i.Id).ToList();
    var activeVariants = p.Variants.Where(v => v.IsActive).ToList();
}

<div class="container my-4">
    <div class="row">
        <div class="col-md-5">
            <img src="@(images.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png")" class="img-fluid rounded mb-2" alt="@p.Name" />
        </div>
        <div class="col-md-7">
            <style>
                .star-input{display:inline-flex;flex-direction:row-reverse}
                .star-input input{position:absolute;opacity:0;pointer-events:none}
                .star-input label{font-size:2rem;line-height:1;color:#ccc;cursor:pointer;padding:0 2px}
                .star-input input:checked~label,.star-input label:hover,.star-input label:hover~label{color:#f5a623}
                .star-input input:focus-visible+label{outline:2px solid #0d6efd}
            </style>
            <style>.product-intro img{max-width:100%}.product-intro img:not([height]):not([style*="height"]){height:auto}</style>
            <h2>@p.Name</h2>
            <p class="text-muted">
                @if (Model.ReviewCount > 0)
                {
                    <span><partial name="_Stars" model="Model.AverageRating" /> @Model.AverageRating.ToString("0.0") (@Model.ReviewCount đánh giá)</span>
                }
                else
                {
                    <span>Chưa có đánh giá</span>
                }
            </p>
            @if (!string.IsNullOrEmpty(p.Origin)) { <p><strong>Nguồn gốc:</strong> @p.Origin</p> }
            @if (activeVariants.Count > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" id="variant-form">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-bold">Quy cách</label>
                        <div class="btn-group d-flex flex-wrap gap-2" role="group">
                            @foreach (var v in activeVariants)
                            {
                                <label class="btn btn-outline-primary @(v == activeVariants.First() ? "active" : "")">
                                    <input type="radio" name="variantId" value="@v.Id" autocomplete="off" class="d-none variant-radio"
                                           data-price="@v.EffectivePrice" @(v == activeVariants.First() ? "checked" : "") />
                                    @v.PackagingSpec — @v.EffectivePrice.ToString("N0")đ @(v.StockQuantity <= 0 ? "(hết hàng)" : "")
                                </label>
                            }
                        </div>
                    </div>
                    <h3 id="selected-price" class="product-price">@activeVariants.First().EffectivePrice.ToString("N0")đ</h3>
                    <div class="d-flex gap-2 mb-3">
                        <input type="number" name="quantity" value="1" min="1" class="form-control" style="width:100px" />
                        <button type="submit" name="redirectTo" value="cart" class="btn btn-primary">Thêm vào giỏ hàng</button>
                        <button type="submit" name="redirectTo" value="checkout" class="btn btn-danger">Mua ngay</button>
                    </div>
                </form>
            }
            else
            {
                <p class="text-muted">Sản phẩm hiện tạm ngừng kinh doanh.</p>
            }
        </div>
    </div>

    <ul class="nav nav-tabs mt-5" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-intro" type="button">Giới thiệu sản phẩm</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-info" type="button">Thông tin &amp; bảo quản</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-reviews" type="button">Đánh giá (@Model.ReviewCount)</button></li>
    </ul>
    <div class="tab-content border border-top-0 rounded-bottom p-3">
        <div class="tab-pane fade show active" id="tab-intro">
            @if (!string.IsNullOrWhiteSpace(p.IntroHtml))
            {
                <div class="product-intro">@Html.Raw(p.IntroHtml)</div>
            }
            else if (!string.IsNullOrWhiteSpace(p.Description))
            {
                <div style="white-space:pre-line">@p.Description</div>
            }
            else
            {
                <p class="text-muted mb-0">Đang cập nhật.</p>
            }
        </div>
        <div class="tab-pane fade" id="tab-info">
            <table class="table table-sm mb-0">
                <tr><th style="width:180px">Nguồn gốc</th><td>@(p.Origin ?? "Đang cập nhật")</td></tr>
                <tr><th>Danh mục</th><td>@p.Category.Name</td></tr>
                @if (!string.IsNullOrEmpty(p.PreservationInstructions)) { <tr><th>Bảo quản</th><td>@p.PreservationInstructions</td></tr> }
                @if (!string.IsNullOrEmpty(p.ExpiryInfo)) { <tr><th>Hạn sử dụng</th><td>@p.ExpiryInfo</td></tr> }
                <tr><th>Quy cách</th><td>@string.Join(", ", activeVariants.Select(v => v.PackagingSpec))</td></tr>
            </table>
        </div>
        <div class="tab-pane fade" id="tab-reviews">
            @foreach (var r in p.Reviews)
            {
                <div class="border-bottom py-2">
                    <strong>@(r.User?.FullName ?? "Khách hàng")</strong> — <partial name="_Stars" model="(double)r.Rating" />
                    <span class="text-muted small ms-2">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    <p class="mb-0">@r.Comment</p>
                </div>
            }
            @if (TempData["ReviewMessage"] is string reviewMsg)
            {
                <div class="alert alert-success mt-3">@reviewMsg</div>
            }
            @if (Model.CanReview)
            {
                foreach (var pu in Model.Purchases)
                {
                    var myRating = pu.Review?.Rating ?? 5;
                    <div class="border rounded p-3 mt-3">
                        <p class="fw-bold mb-1">Đơn @pu.OrderCode (@pu.OrderDate.ToLocalTime().ToString("dd/MM/yyyy")) — @pu.PackagingSpec</p>
                        @if (!pu.CanEdit)
                        {
                            <div><partial name="_Stars" model="(double)pu.Review!.Rating" /></div>
                            <p class="mb-1">@pu.Review.Comment</p>
                            <p class="text-muted small mb-0">Bạn đã đánh giá lần mua này. Đã quá 24 giờ nên không thể chỉnh sửa.</p>
                        }
                        else
                        {
                            <form asp-controller="Product" asp-action="AddReview" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderDetailId" value="@pu.OrderDetailId" />
                                @if (pu.Review is not null) { <p class="small text-muted mb-1">Bạn có thể chỉnh sửa đánh giá này trong vòng 24 giờ sau khi gửi.</p> }
                                <div class="mb-2 d-flex align-items-center gap-2">
                                    <div class="star-input">
                                        @for (var s = 5; s >= 1; s--)
                                        {
                                            <input type="radio" name="rating" id="star-@pu.OrderDetailId-@s" value="@s" @(s == myRating ? "checked" : "") />
                                            <label for="star-@pu.OrderDetailId-@s" title="@s sao">★</label>
                                        }
                                    </div>
                                    <span class="star-label text-muted small"></span>
                                </div>
                                <textarea name="comment" class="form-control mb-2" placeholder="Nhận xét của bạn...">@pu.Review?.Comment</textarea>
                                <button type="submit" class="btn btn-outline-primary">@(pu.Review is null ? "Gửi đánh giá" : "Cập nhật đánh giá")</button>
                            </form>
                        }
                    </div>
                }
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <p class="text-muted mb-0">Đăng nhập và mua hàng để viết đánh giá.</p>
            }
            else
            {
                <p class="text-muted mb-0">Chỉ khách đã mua và nhận hàng thành công mới đánh giá được sản phẩm này.</p>
            }
        </div>
    </div>

    @if (Model.RelatedProducts.Count > 0)
    {
        <h4 class="mt-5">Sản phẩm liên quan</h4>
        <div class="row">
            @foreach (var rp in Model.RelatedProducts) { <partial name="_ProductCard" model="rp.ToCard()" /> }
        </div>
    }

</div>

@section Scripts {
    <script>
        if (location.hash === '#tab-reviews') {
            var reviewTab = document.querySelector('[data-bs-target="#tab-reviews"]');
            if (reviewTab) bootstrap.Tab.getOrCreateInstance(reviewTab).show();
        }
        (function () {
            var names = { 1: 'Tệ', 2: 'Không hài lòng', 3: 'Bình thường', 4: 'Hài lòng', 5: 'Tuyệt vời' };
            document.querySelectorAll('.star-input').forEach(function (group) {
                var label = group.parentElement.querySelector('.star-label');
                var update = function () {
                    var c = group.querySelector('input:checked');
                    label.textContent = c ? names[c.value] : '';
                };
                group.querySelectorAll('input').forEach(function (i) { i.addEventListener('change', update); });
                update();
            });
        })();
        document.querySelectorAll('.variant-radio').forEach(r => {
            r.addEventListener('change', function () {
                document.getElementById('selected-price').textContent =
                    Number(this.dataset.price).toLocaleString('vi-VN') + 'đ';
                document.querySelectorAll('.variant-radio').forEach(x => x.closest('label').classList.toggle('active', x.checked));
            });
        });
    </script>
}
