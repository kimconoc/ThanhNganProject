@model double
@{ var filled = (int)Math.Round(Model, MidpointRounding.AwayFromZero); }
<span class="tn-stars" title="@Model.ToString("0.0")/5" aria-label="@Model.ToString("0.0") trên 5 sao"><span style="color:#f5a623">@(new string('★', filled))</span><span style="color:#ccc">@(new string('★', 5 - filled))</span></span>
