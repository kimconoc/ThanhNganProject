@inject ThanhNgan.Web.Data.ApplicationDbContext Db
@{ var contact = await ThanhNgan.Web.Data.ContactSettings.GetAsync(Db); }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thanh Ngân Seafood</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="top-bar text-white py-1">
            <div class="container d-flex justify-content-between flex-wrap">
                <span class="top-bar-hotline">📞 Hotline: <a href="tel:@contact.Hotline.Replace(" ", "")">@contact.Hotline</a> &nbsp;|&nbsp; Zalo: <a href="tel:@contact.Zalo.Replace(" ", "")">@contact.Zalo</a></span>
                <span>🚚 Giao hàng nội thành &amp; giao tỉnh xe lạnh toàn quốc</span>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg main-navbar border-bottom shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-3" asp-area="" asp-controller="Home" asp-action="Index">🦐 Thanh Ngân</a>
                <div class="d-flex d-lg-none align-items-center gap-2">
                    <a class="btn btn-cart btn-sm position-relative" asp-area="" asp-controller="Cart" asp-action="Index">
                        🛒
                        <span class="cart-count-badge badge bg-danger rounded-pill">0</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
                <form class="d-flex d-lg-none w-100 mt-2 order-3" asp-area="" asp-controller="Shop" asp-action="Index" method="get">
                    <input class="form-control form-control-sm" type="search" name="keyword" placeholder="Tìm sản phẩm..." />
                </form>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Shop" asp-action="Index" asp-route-categorySlug="hai-san-dong-lanh">Hải sản đông lạnh</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Shop" asp-action="Index" asp-route-categorySlug="hai-san-tuoi-song">Hải sản tươi sống</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Shop" asp-action="Index" asp-route-categorySlug="mam-ca-com">Mắm cá cơm</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Blog">Cẩm nang</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Page" asp-route-slug="gioi-thieu">Giới thiệu</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                    </ul>
                    <form class="d-none d-lg-flex me-3" asp-area="" asp-controller="Shop" asp-action="Index" method="get">
                        <input class="form-control form-control-sm" type="search" name="keyword" placeholder="Tìm sản phẩm..." />
                    </form>
                    <a class="btn btn-cart btn-sm me-3 position-relative" asp-area="" asp-controller="Cart" asp-action="Index">
                        🛒 Giỏ hàng
                        <span class="cart-count-badge badge bg-danger rounded-pill">0</span>
                    </a>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
        <div class="service-strip">
            <div class="container">
                <div class="row text-center text-md-start">
                    <div class="col-6 col-md-3 service-item">
                        <span class="icon">🚚</span>
                        <div><div class="title">Giao hàng nhanh</div><div class="subtitle">Nội thành trong 2 giờ</div></div>
                    </div>
                    <div class="col-6 col-md-3 service-item">
                        <span class="icon">❄️</span>
                        <div><div class="title">Xe lạnh toàn quốc</div><div class="subtitle">Giữ trọn độ tươi ngon</div></div>
                    </div>
                    <div class="col-6 col-md-3 service-item">
                        <span class="icon">↩️</span>
                        <div><div class="title">Đổi trả dễ dàng</div><div class="subtitle">Hàng không đạt chuẩn</div></div>
                    </div>
                    <div class="col-6 col-md-3 service-item">
                        <span class="icon">✅</span>
                        <div><div class="title">Cam kết chất lượng</div><div class="subtitle">Nguồn gốc rõ ràng</div></div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    @{
        var cartMsg = TempData["CartMessage"] as string;
    }
    @if (!string.IsNullOrEmpty(cartMsg))
    {
        <div class="alert alert-success text-center mb-0 rounded-0">@cartMsg</div>
    }

    <main role="main">
        @RenderBody()
    </main>

    <div class="floating-contact-widget">
        <div class="inner-fabs">
            @if (!string.IsNullOrWhiteSpace(contact.Messenger))
            {
                <a class="fab fab-sm messenger" href="@ThanhNgan.Web.Data.ContactSettings.MessengerChatUrl(contact.Messenger)" target="_blank" rel="noopener" data-tooltip="Chat Messenger">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.24 0 0 4.952 0 11.64c0 3.499 1.434 6.521 3.769 8.61a.96.96 0 0 1 .323.683l.065 2.135a.96.96 0 0 0 1.347.85l2.381-1.053a.96.96 0 0 1 .641-.046A13 13 0 0 0 12 23.28c6.76 0 12-4.952 12-11.64S18.76 0 12 0m6.806 7.44c.522-.03.971.567.63 1.094l-4.178 6.457a.707.707 0 0 1-.977.208l-3.87-2.504a.44.44 0 0 0-.49.007l-4.363 3.01c-.637.438-1.415-.317-.995-.966l4.179-6.457a.706.706 0 0 1 .977-.21l3.87 2.505c.15.097.344.094.491-.007l4.362-3.008a.7.7 0 0 1 .364-.13" /></svg>
                </a>
            }
            <a class="fab fab-sm zalo" href="@ThanhNgan.Web.Data.ContactSettings.ZaloChatUrl(contact.Zalo)" target="_blank" rel="noopener" data-tooltip="Nhắn tin Zalo">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.49 10.2722v-.4496h1.3467v6.3218h-.7704a.576.576 0 01-.5763-.5729l-.0006.0005a3.273 3.273 0 01-1.9372.6321c-1.8138 0-3.2844-1.4697-3.2844-3.2823 0-1.8125 1.4706-3.2822 3.2844-3.2822a3.273 3.273 0 011.9372.6321l.0006.0005zM6.9188 7.7896v.205c0 .3823-.051.6944-.2995 1.0605l-.03.0343c-.0542.0615-.1815.206-.2421.2843L2.024 14.8h4.8948v.7682a.5764.5764 0 01-.5767.5761H0v-.3622c0-.4436.1102-.6414.2495-.8476L4.8582 9.23H.1922V7.7896h6.7266zm8.5513 8.3548a.4805.4805 0 01-.4803-.4798v-7.875h1.4416v8.3548H15.47zM20.6934 9.6C22.52 9.6 24 11.0807 24 12.9044c0 1.8252-1.4801 3.306-3.3066 3.306-1.8264 0-3.3066-1.4808-3.3066-3.306 0-1.8237 1.4802-3.3044 3.3066-3.3044zm-10.1412 5.253c1.0675 0 1.9324-.8645 1.9324-1.9312 0-1.065-.865-1.9295-1.9324-1.9295s-1.9324.8644-1.9324 1.9295c0 1.0667.865 1.9312 1.9324 1.9312zm10.1412-.0033c1.0737 0 1.945-.8707 1.945-1.9453 0-1.073-.8713-1.9436-1.945-1.9436-1.0753 0-1.945.8706-1.945 1.9436 0 1.0746.8697 1.9453 1.945 1.9453z" /></svg>
            </a>
        </div>
        <a class="hotline-wrap" href="tel:@contact.Hotline.Replace(" ", "")">
            <span class="hotline-bar">@contact.Hotline</span>
            <span class="fab fab-lg call call-animation">
                <svg viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/></svg>
            </span>
        </a>
    </div>

    <footer class="site-footer text-white mt-5">
        <div class="container pt-4 pb-3">
            <div class="row">
                <div class="col-md-3 mb-4">
                    <a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index">🦐 Thanh Ngân Seafood</a>
                    <p class="small text-white-50 mt-2">Chuyên hải sản đông lạnh, tươi sống và mắm cá cơm chất lượng, giao tận nơi.</p>
                    <ul class="list-unstyled small text-white-50 footer-commit-list">
                        <li>🚚 Giao hàng nhanh trong 2 giờ</li>
                        <li>❄️ Xe lạnh toàn quốc</li>
                        <li>↩️ Đổi trả dễ dàng</li>
                        <li>✅ Cam kết chất lượng</li>
                    </ul>
                </div>
                <div class="col-6 col-md-3 mb-4">
                    <h6 class="footer-heading">Danh mục</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-area="" asp-controller="Shop" asp-action="Index" asp-route-categorySlug="hai-san-dong-lanh">Hải sản đông lạnh</a></li>
                        <li><a asp-area="" asp-controller="Shop" asp-action="Index" asp-route-categorySlug="hai-san-tuoi-song">Hải sản tươi sống</a></li>
                        <li><a asp-area="" asp-controller="Shop" asp-action="Index" asp-route-categorySlug="mam-ca-com">Mắm cá cơm</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Blog">Cẩm nang</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3 mb-4">
                    <h6 class="footer-heading">Chính sách</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-area="" asp-controller="Home" asp-action="Page" asp-route-slug="chinh-sach-giao-hang">Chính sách giao hàng</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Page" asp-route-slug="chinh-sach-doi-tra">Chính sách đổi trả</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Faq">Câu hỏi thường gặp</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Page" asp-route-slug="gioi-thieu">Giới thiệu</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="footer-heading">Liên hệ</h6>
                    <ul class="list-unstyled small text-white-50 footer-contact-list">
                        <li><span>📞</span> @contact.Hotline</li>
                        <li><span>💬</span> Zalo: @contact.Zalo</li>
                        <li><span>✉️</span> @contact.Email</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="text-center small text-white-50 border-top border-secondary py-2">
            &copy; @DateTime.Now.Year - Thanh Ngân Seafood
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
