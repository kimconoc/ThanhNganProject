@using Microsoft.AspNetCore.Identity
@using ThanhNgan.Web.Models.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = !string.IsNullOrWhiteSpace(currentUser?.FullName)
        ? currentUser.FullName
        : User.Identity!.Name!.Split('@')[0];
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">Xin chào, @displayName</a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">Thông tin tài khoản</a></li>
            <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Addresses">Sổ địa chỉ</a></li>
            <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="OrderHistory">Đơn hàng của tôi</a></li>
            <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Wishlist">Sản phẩm yêu thích</a></li>
            @if (User.IsInRole("WarehouseStaff") || User.IsInRole("SalesStaff") || User.IsInRole("Manager") || User.IsInRole("Admin"))
            {
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang quản trị</a></li>
            }
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item">Đăng xuất</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
    </li>
}
</ul>
