@model ProductCardViewModel
<div class="col-6 col-md-3 mb-4">
    <div class="card product-card h-100 shadow-sm">
        <a asp-controller="Product" asp-action="Details" asp-route-slug="@Model.Slug" class="card-img-wrap">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.png" : Model.ImageUrl)" class="card-img-top" alt="@Model.Name" style="height:180px;object-fit:cover;" />
            @if (Model.MinSalePrice.HasValue)
            {
                var percentOff = (int)Math.Round((1 - Model.MinSalePrice!.Value / Model.MinPrice) * 100);
                <span class="badge badge-discount text-white">-@percentOff%</span>
            }
            @if (Model.IsNew) { <span class="badge bg-success badge-new">Mới</span> }
            @if (Model.IsOutOfStock) { <span class="badge bg-secondary badge-new">Hết hàng</span> }
        </a>
        <div class="card-body d-flex flex-column">
            <a asp-controller="Product" asp-action="Details" asp-route-slug="@Model.Slug" class="text-decoration-none text-dark">
                <h6 class="card-title">@Model.Name</h6>
            </a>
            <div class="mt-auto">
                @if (Model.MinSalePrice.HasValue)
                {
                    <span class="price-sale">@Model.MinSalePrice.Value.ToString("N0")đ</span>
                    <span class="text-muted text-decoration-line-through small">@Model.MinPrice.ToString("N0")đ</span>
                }
                else
                {
                    <span class="fw-bold">@Model.MinPrice.ToString("N0")đ</span>
                }
                <form class="add-to-cart-form mt-2" asp-controller="Cart" asp-action="Add" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="variantId" value="@Model.DefaultVariantId" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="btn btn-sm btn-primary btn-add-cart w-100" @(Model.IsOutOfStock ? "disabled" : "")>Thêm vào giỏ</button>
                </form>
            </div>
        </div>
    </div>
</div>
