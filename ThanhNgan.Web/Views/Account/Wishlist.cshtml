@model List<Wishlist>
@{ ViewData["Title"] = "Sản phẩm yêu thích"; }
<div class="container my-4">
    <h2 class="mb-4">Sản phẩm yêu thích</h2>
    <div class="row">
        @foreach (var w in Model) { <partial name="_ProductCard" model="w.Product.ToCard()" /> }
    </div>
    @if (Model.Count == 0) { <p>Bạn chưa thêm sản phẩm yêu thích nào.</p> }
</div>
