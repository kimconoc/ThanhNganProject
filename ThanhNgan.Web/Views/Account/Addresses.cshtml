@model List<Address>
@{ ViewData["Title"] = "Sổ địa chỉ"; }
<div class="container my-4">
    <h2 class="mb-4">Sổ địa chỉ giao hàng</h2>

    @foreach (var a in Model)
    {
        <div class="card mb-2 @(a.IsDefault ? "border-primary border-2 bg-primary-subtle" : "")">
            <div class="card-body d-flex justify-content-between">
                <div>
                    <strong>@a.RecipientName</strong> - @a.Phone
                    @if (a.IsDefault)
                    {
                        <span class="badge bg-primary">Mặc định</span>
                    }
                    <p class="mb-0 text-muted">@a.DetailAddress, @a.Ward, @a.District, @a.Province</p>
                </div>
                <div class="d-flex gap-1 align-items-start">
                    @if (!a.IsDefault)
                    {
                        <form asp-action="SetDefaultAddress" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <button class="btn btn-sm btn-outline-primary">Đặt làm mặc định</button>
                        </form>
                    }
                    <form asp-action="DeleteAddress" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@a.Id" />
                        <button class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </div>
            </div>
        </div>
    }

    <h5 class="mt-4">Thêm địa chỉ mới</h5>
    <form asp-action="SaveAddress" method="post" class="row g-2">
        @Html.AntiForgeryToken()
        <div class="col-md-6"><input name="RecipientName" class="form-control" placeholder="Họ tên người nhận" required /></div>
        <div class="col-md-6"><input name="Phone" class="form-control" placeholder="Số điện thoại" required /></div>
        <div class="col-md-4"><input name="Province" class="form-control" placeholder="Tỉnh/Thành" required /></div>
        <div class="col-md-4"><input name="District" class="form-control" placeholder="Quận/Huyện" required /></div>
        <div class="col-md-4"><input name="Ward" class="form-control" placeholder="Phường/Xã" required /></div>
        <div class="col-12"><input name="DetailAddress" class="form-control" placeholder="Địa chỉ chi tiết" required /></div>
        <div class="col-12 form-check">
            <input type="checkbox" name="IsDefault" value="true" class="form-check-input" id="isDefault" />
            <label class="form-check-label" for="isDefault">Đặt làm địa chỉ mặc định</label>
        </div>
        <div class="col-12"><button class="btn btn-primary">Lưu địa chỉ</button></div>
    </form>
</div>
